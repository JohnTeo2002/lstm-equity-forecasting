# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and populate the actual secrets locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (Python / FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Allowed CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Market Data Providers
# ------------------------------------------------------------------------------
# Alpha Vantage / Polygon / Yahoo Finance credentials
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here

# ------------------------------------------------------------------------------
# Model Inference & Machine Learning Settings
# ------------------------------------------------------------------------------
MODEL_WEIGHTS_PATH=./backend/weights/lstm_equity_v2.pt
SEQUENCE_LENGTH=60
FORECAST_DEFAULT_HORIZON=5
TORCH_DEVICE=cpu # 'cpu', 'cuda', or 'mps'

# ------------------------------------------------------------------------------
# Database & Caching (Optional / Production)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./equity_forecast.db
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

